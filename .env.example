# Core
NODE_ENV=development
HTTP_PORT=3000

# Finance DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=finance
# DB_SCHEMA=

# Farm DB
FARM_DB_HOST=localhost
FARM_DB_PORT=5432
FARM_DB_USER=postgres
FARM_DB_PASSWORD=
FARM_DB_NAME=farm
FARM_DB_SCHEMA=farm_ext

# Optional sync/HR DB
# SYNC_DB_HOST=
# SYNC_DB_NAME=

# MQTT
BROKER_HOST=localhost
BROKER_PORT=1883
BROKER_USER=
BROKER_PASSWORD=

# Internal API (queue, taurus, card-block): header Api-Key
QUEUE_API_KEY=
ENCRYPTION_KEY=

# Slack proxy (optional)
SLACK_APP_URL=
SLACK_APP_API_KEY=
# SLACK_ALL_TO_CHANNEL=dev-hub

# Basic auth for balances (optional)
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=

# Payment providers (enable by setting BASE_URL)
# ADSCARDS_BASE_URL=
# ADSCARDS_API_KEY=
# ECARDS_BASE_URL=
# ECARDS_USERNAME=
# ECARDS_PASSWORD=
# MULTICARDS_BASE_URL=
# MULTICARDS_EMAIL=
# MULTICARDS_PASSWORD=
# STELLARCARDS_BASE_URL=
# STELLARCARDS_API_KEY=

# Dev simulation
# DEV_SIMULATION_ENABLED=true
